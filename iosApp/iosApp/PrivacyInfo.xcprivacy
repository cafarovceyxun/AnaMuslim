<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy manifest. Required since 2024 — an upload without it, or one that uses a "required reason"
  API it does not declare, is rejected with ITMS-91053.

  This file lives inside the `iosApp/iosApp` PBXFileSystemSynchronizedRootGroup, so Xcode picks it
  up and copies it into the bundle automatically; there is no build-phase entry to keep in sync.

  Scope note: everything the app ships is first-party or statically linked into the `shared`
  framework (Ktor, supabase-kt, okio, Room, Compose). None of those arrive as XCFrameworks with
  their own manifests, so this one file has to cover them too.
-->
<plist version="1.0">
<dict>
	<!-- No IDFA, no ad networks, no cross-app measurement. Telemetry was removed outright on
	     2026-07-18 (AnalyticsSyncWorker, ActivityTracker and the Supabase activity tables). -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!--
	  What actually leaves the device, and why. All three are tied to the signed-in account and none
	  of them feed tracking or advertising.

	  ⚠️ These entries must agree with the App Privacy questionnaire in App Store Connect — the two
	  are checked against each other, and the questionnaire is what users see on the product page.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Supabase email sign-in (AuthViewModel → signInWith(Email)). Needed for the moderation
		     flow: only a signed-in account may submit translation/hadith corrections. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- The Supabase account UUID, attached to submitted corrections so moderation can
		     attribute and review them (VerseReportViewModel → submission.user_id). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Free-text the user writes into a verse/hadith correction report. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<!-- "Required reason" APIs. Each entry is a category Apple gates, plus the reason code that
	     covers our use of it. Missing entries here are the usual cause of an ITMS-91053 rejection. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- NSUserDefaults — IosAppLocale reads/writes AppleLanguages so the in-app language choice
		     survives relaunch. CA92.1 = access info from the same app only. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!-- File timestamps — AppFileSystem (okio metadataOrNull) checks size/mtime of downloaded
		     translations, recitations, fonts and page images. Everything it touches is under
		     NSDocumentDirectory, i.e. our own container. DDA9.1 = files inside the app container. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>DDA9.1</string>
			</array>
		</dict>
		<!-- System boot time — not called by our own code, but the Kotlin/Native runtime and
		     Compose Multiplatform drive animations and coroutine timing off a monotonic clock
		     (mach_absolute_time). 35F9.1 = measuring elapsed time between in-app events. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
