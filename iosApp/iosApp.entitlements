<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app writes the prayer snapshot here, the widget extension reads it. Both sides must
	     name the same group, and it must exist in the developer portal for device builds —
	     `NSUserDefaults(suiteName:)` fails silently otherwise (see IosPrayerWidgetBridge). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.cafarovceyxun.anamuslim</string>
	</array>
</dict>
</plist>
