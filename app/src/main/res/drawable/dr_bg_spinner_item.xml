<?xml version="1.0" encoding="utf-8"?>
<!--
  Moved here from the removed `peacedesign` module. Still live: the app theme wires it up through
  `android:dropDownListViewStyle` -> `@style/ListView` -> `android:listSelector`.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="150">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/colorPrimary" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="?colorControlHighlight" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
