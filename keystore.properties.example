# Release signing template.
# Copy to `keystore.properties` (git-ignored) and fill in real values:
#
#     cp keystore.properties.example keystore.properties
#
# NEVER commit the real file or the keystore itself. Losing the keystore means
# you can no longer update the app on Google Play under the same key.
#
# If `keystore.properties` is absent (CI, forks, contributors), release builds
# still work — they are simply left unsigned. See app/build.gradle.kts.
#
# In CI, write these four values from repository secrets into keystore.properties
# (and place the keystore file) before running `assembleRelease`.
#
# Create a keystore, if you do not have one yet:
#
#     keytool -genkeypair -v -keystore keys/release.keystore \
#         -alias anamuslim -keyalg RSA -keysize 2048 -validity 10000
#
# `keys/` is already git-ignored.

# Path to the keystore file. NOTE: resolved relative to the `app/` module
# directory, not the repo root — `../keys/…` means `<repo>/keys/…`.
# An absolute path works too.
storeFile=../keys/release.keystore

# Password of the keystore file itself.
storePassword=CHANGE_ME

# The key entry inside the keystore (`-alias` above).
keyAlias=CHANGE_ME

# Password of that key entry. Often the same as storePassword.
keyPassword=CHANGE_ME
